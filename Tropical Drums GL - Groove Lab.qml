    property string statusText: "Selecione o ponto inicial em uma pauta de bateria e clique em um ritmo."
    function setupCursorAtSelection() { var cursor = curScore.newCursor(); cursor.rewind(1); return cursor; }
    function gcd(a,b){ a=Math.abs(a); b=Math.abs(b); while(b!==0){ var t=b; b=a%b; a=t; } return a||1; }
    function durationFromSteps(stepCount, stepDenominator){ var d=gcd(stepCount, stepDenominator); return { z: stepCount/d, n: stepDenominator/d }; }
    function hitsAtStep(events, step){ var hits=[]; for(var i=0;i<events.length;i++) if(events[i].step===step) hits.push(events[i]); return hits; }
    function nextHitStep(events,currentStep,endStep){ var next=endStep; for(var i=0;i<events.length;i++){ var s=events[i].step; if(s>currentStep && s<next) next=s; } return next; }
    function addDrumChordAtCursor(cursor, track, hits, durationZ, durationN){ cursor.track=track; cursor.setDuration(durationZ,durationN); for(var i=0;i<hits.length;i++){ cursor.addNote(hits[i].pitch, i>0); } }
    function addRestAtCursor(cursor, track, durationZ, durationN){ cursor.track=track; cursor.setDuration(durationZ,durationN); cursor.addRest(); }
    function nextBarBoundary(step, stepsPerBar, endStep){ var boundary=(Math.floor(step/stepsPerBar)+1)*stepsPerBar; return Math.min(boundary,endStep); }
    function nextChangeStep(events,currentStep,endStep,stepsPerBar){ var next=nextBarBoundary(currentStep,stepsPerBar,endStep); for(var i=0;i<events.length;i++){ var s=events[i].step; if(s>currentStep && s<next) next=s; } return next; }
    function generateDrumPattern(label,bars,stepsPerBar,stepDenominator,events,timeSig){ if(!curScore){statusText="Nenhuma partitura aberta.";return;} var cursor=setupCursorAtSelection(); var track=cursor.track; var endStep=bars*stepsPerBar; var inserted=0; var step=0; curScore.startCmd(); while(step<endStep){ var hits=hitsAtStep(events,step); var nextStep=nextChangeStep(events,step,endStep,stepsPerBar); var gap=nextStep-step; if(gap<=0)gap=1; var dur=durationFromSteps(gap,stepDenominator); if(hits.length>0){ addDrumChordAtCursor(cursor,track,hits,dur.z,dur.n); inserted+=hits.length; } else { addRestAtCursor(cursor,track,dur.z,dur.n); } step=nextStep; } curScore.endCmd(); statusText=label+": "+inserted+" notas de bateria inseridas com durações fundidas."; }
